<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:padding="24dp">

    <!-- Header bar with back button, green border title, and more options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="?android:attr/actionModeCloseDrawable"
            android:background="?android:attr/selectableItemBackground"
            android:tint="#FFFFFF"
            android:contentDescription="Go back"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Class Profile"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/border_green"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⋮"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="More options"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes" />

    </LinearLayout>

    <!-- Class details header -->
    <TextView
        android:id="@+id/tvClassDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class Details"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="yes" />

    <!-- Active filter text status -->
    <TextView
        android:id="@+id/tvActiveFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF4CAF50"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:importantForAccessibility="yes" />

    <!-- Clear Filter Button (lavender style, 48dp min height) -->
    <Button
        android:id="@+id/btnClearFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="48dp"
        android:text="Clear Filter"
        android:textColor="#000000"
        android:backgroundTint="@color/lavender"
        android:contentDescription="Clear filter"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="yes" />

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <!-- Center empty message -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No student data found. Please import your class list from Sampoorna."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:visibility="visible" />

        <!-- Student List RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStudents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Button: Share Student List -->
    <Button
        android:id="@+id/btnShareStudentList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Share Student List"
        android:textColor="#000000"
        android:backgroundTint="@color/lavender"
        android:contentDescription="Share student list"
        android:importantForAccessibility="yes" />

</LinearLayout>
