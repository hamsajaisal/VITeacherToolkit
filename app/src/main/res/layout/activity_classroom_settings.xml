<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:importantForAccessibility="yes"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Go back button"
                android:tint="#FFFFFF"
                android:padding="12dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Classroom Settings"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/border_green"
                android:gravity="center"
                android:accessibilityHeading="true"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <!-- Description text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure your class and academic year details below."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="yes" />

        <!-- Input Field: Standard or Class -->
        <TextView
            android:id="@+id/tvClassStandardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard or Class"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etClassStandard" />

        <EditText
            android:id="@+id/etClassStandard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e.g. 6"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:nextFocusForward="@id/etClassDivision"
            android:layout_marginBottom="20dp"
            android:contentDescription="Class standard edit box"
            android:importantForAccessibility="yes" />

        <!-- Input Field: Division -->
        <TextView
            android:id="@+id/tvClassDivisionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Division"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etClassDivision" />

        <EditText
            android:id="@+id/etClassDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e.g. B"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:nextFocusForward="@id/etClassAcademicYear"
            android:layout_marginBottom="20dp"
            android:contentDescription="Division edit box"
            android:importantForAccessibility="yes" />

        <!-- Input Field: Academic Year -->
        <TextView
            android:id="@+id/tvClassAcademicYearLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Academic Year"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etClassAcademicYear" />

        <EditText
            android:id="@+id/etClassAcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e.g. 2025-26"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:nextFocusForward="@id/btnSaveClassroomSettings"
            android:layout_marginBottom="28dp"
            android:contentDescription="Academic year edit box"
            android:importantForAccessibility="yes" />

        <!-- Button: Save Classroom Settings -->
        <Button
            android:id="@+id/btnSaveClassroomSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Save My Class"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Save My Class settings button"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
