<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Timetable Entry"
            android:textSize="26sp"
            android:layout_marginBottom="24dp"
            android:accessibilityHeading="true"/>

        <TextView
            android:id="@+id/tvDayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Day"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/spinnerDay"/>

        <Spinner
            android:id="@+id/spinnerDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Select the day of the week"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvPeriodLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Period Number"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/spinnerPeriod"/>

        <Spinner
            android:id="@+id/spinnerPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Select the period number"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubjectLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etSubject"/>

        <EditText
            android:id="@+id/etSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: Malayalam"
            android:contentDescription="Subject name edit box"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvClassLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etClass"/>

        <EditText
            android:id="@+id/etClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 7"
            android:contentDescription="Class number edit box"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvDivisionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Division"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/etDivision"/>

        <EditText
            android:id="@+id/etDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: A"
            android:contentDescription="Division edit box"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvReminderLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remind me before class"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            android:labelFor="@id/spinnerReminder"/>

        <Spinner
            android:id="@+id/spinnerReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Select when to be reminded before class"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSaveEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Timetable Entry"
            android:contentDescription="Save this timetable entry"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCancelEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:contentDescription="Cancel and go back"/>

    </LinearLayout>

</ScrollView>