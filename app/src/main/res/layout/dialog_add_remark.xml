<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#000000">

    <!-- Subject Selection Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Subject"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="yes" />

    <Spinner
        android:id="@+id/spinnerSubject"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="Select subject dropdown"
        android:layout_marginBottom="20dp"
        android:importantForAccessibility="yes" />

    <!-- Remark Text Entry Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Remark"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="yes" />

    <EditText
        android:id="@+id/etRemarkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:gravity="top|start"
        android:hint="Type the remark here..."
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#111111"
        android:padding="12dp"
        android:inputType="textMultiLine"
        android:contentDescription="Enter remark text field"
        android:importantForAccessibility="yes" />

</LinearLayout>
