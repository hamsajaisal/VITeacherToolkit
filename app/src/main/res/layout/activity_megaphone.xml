<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground"
    android:padding="24dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Go Back"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bluetooth Megaphone"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Howling Warning Alert Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFF9C4"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:importantForAccessibility="yes"
                android:contentDescription="Important feedback warning. To prevent a loud screeching feedback sound (howling), please stand away from the Bluetooth speaker and do not point the phone's microphone directly at it. Keep a safe distance and set a moderate volume.">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Howling Feedback Warning"
                    android:textColor="#5D4037"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To prevent a loud screeching feedback sound, please do not stand too close to the Bluetooth speaker and do not point the phone's microphone directly at the speaker. Maintain a safe distance (at least 2–3 meters) and set a moderate volume."
                    android:textColor="#5D4037"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Main Toggle Button -->
            <Button
                android:id="@+id/btnToggleMegaphone"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:backgroundTint="@color/lavender"
                android:textColor="#000000"
                android:text="Turn ON"
                android:textSize="20sp"
                android:textStyle="bold"
                android:contentDescription="Turn Megaphone ON"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Voice Activity Level Visualizer -->
            <TextView
                android:id="@+id/tvVoiceLevelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice Input Activity"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pbVoiceLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/lavender_dark"
                android:layout_marginBottom="32dp"
                android:importantForAccessibility="yes"
                android:contentDescription="Voice level indicator" />

            <!-- Digital Voice Boost (Gain Control) -->
            <TextView
                android:id="@+id/tvVoiceBoostLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Digital Voice Boost: 1.0x"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sbVoiceBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="10"
                android:progressTint="@color/lavender_dark"
                android:thumbTint="@color/lavender_dark"
                android:contentDescription="Digital Voice Boost slider"
                android:layout_marginBottom="32dp" />

            <!-- Feature Info / Capabilities -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?android:attr/colorBackground"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvEchoCancelerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acoustic Echo Canceler: Checking..."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvNoiseSuppressorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Noise Suppressor: Checking..."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
