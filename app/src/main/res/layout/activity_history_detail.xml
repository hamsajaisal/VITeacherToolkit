<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="?android:attr/actionModeCloseDrawable"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF"
                android:contentDescription="Go back button"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="History Detail"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/border_green"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true"
                android:importantForAccessibility="yes" />

        </LinearLayout>

        <!-- Selected Date Header -->
        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="22 May 2026"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="yes" />

        <!-- Forenoon Card Section -->
        <LinearLayout
            android:id="@+id/layoutForenoonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_history_item"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forenoon Session"
                android:textColor="@color/lavender_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvForenoonStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Present: 0 | Absent: 0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="yes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Absentees:"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvForenoonAbsentees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="None"
                android:textColor="#FFCCCCCC"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:importantForAccessibility="yes" />

            <Button
                android:id="@+id/btnShareForenoon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:text="Share Forenoon Absentees"
                android:textColor="#000000"
                android:backgroundTint="@color/lavender"
                android:contentDescription="Share Forenoon absentees report button"
                android:importantForAccessibility="yes" />

        </LinearLayout>

        <!-- Afternoon Card Section -->
        <LinearLayout
            android:id="@+id/layoutAfternoonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_history_item"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Afternoon Session"
                android:textColor="@color/lavender_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvAfternoonStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Present: 0 | Absent: 0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="yes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Absentees:"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvAfternoonAbsentees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="None"
                android:textColor="#FFCCCCCC"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:importantForAccessibility="yes" />

            <Button
                android:id="@+id/btnShareAfternoon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:text="Share Afternoon Absentees"
                android:textColor="#000000"
                android:backgroundTint="@color/lavender"
                android:contentDescription="Share Afternoon absentees report button"
                android:importantForAccessibility="yes" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
