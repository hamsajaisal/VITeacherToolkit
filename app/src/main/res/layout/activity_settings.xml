<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:importantForAccessibility="yes"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes" />

        <!-- Existing Button: Set School Hour Schedule -->
        <Button
            android:id="@+id/btnSchoolHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Set School Hour Schedule"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Set up your school period timings"
            android:layout_marginBottom="24dp" />

        <!-- Existing Heading: Reminder Announcement Language -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reminder Announcement Language"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes" />

        <!-- Existing Label: Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the language for TTS class reminders"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="yes" />

        <!-- Existing Spinner: Language Select -->
        <Spinner
            android:id="@+id/spinnerLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="Select reminder language, English or Malayalam"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="yes" />

        <!-- Existing Button: Save Language Setting -->
        <Button
            android:id="@+id/btnSaveLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Save Language Setting"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Save the selected reminder language"
            android:layout_marginBottom="24dp" />

        <!-- Visual Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnClassroomSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Classroom Settings"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Classroom Settings button. Configure class, division, and academic year. This is a feature for class teachers."
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>