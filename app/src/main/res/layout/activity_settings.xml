<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:importantForAccessibility="yes"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes" />

        <!-- Button: Edit User Profile -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Edit User Profile"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Edit your profile details and security PIN"
            android:layout_marginBottom="24dp" />

        <!-- Existing Button: Set School Hour Schedule -->
        <Button
            android:id="@+id/btnSchoolHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Set School Hour Schedule"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Set up your school period timings"
            android:layout_marginBottom="24dp" />

        <!-- Button: TTS Settings -->
        <Button
            android:id="@+id/btnTtsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="TTS Settings"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Text to speech settings button. Configure language, engine, speed, and volume of speech announcements."
            android:layout_marginBottom="24dp" />

        <!-- Button: Theme Settings -->
        <Button
            android:id="@+id/btnThemeSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="App Theme"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="App theme settings button. Choose System Default, Light Theme, or Dark Theme."
            android:layout_marginBottom="24dp" />

        <!-- Visual Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnClassroomSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Classroom Settings"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Classroom Settings button. Configure class, division, and academic year. This is a feature for class teachers."
            android:layout_marginBottom="24dp" />

        <!-- Backup Option -->
        <Button
            android:id="@+id/btnBackupData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Backup Application Data"
            android:textColor="#000000"
            android:backgroundTint="@color/lavender"
            android:contentDescription="Backup application data button. Exports all your notes, timetables, classes, and historical registers to a database file."
            android:layout_marginBottom="16dp" />

        <!-- Restore Option -->
        <Button
            android:id="@+id/btnRestoreData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Restore Application Data"
            android:textColor="?android:attr/textColorPrimary"
            android:backgroundTint="#FF444444"
            android:contentDescription="Restore application data button. Imports database file to overwrite current app settings. Warning: This cannot be undone."
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>