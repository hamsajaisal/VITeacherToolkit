<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="?android:attr/actionModeCloseDrawable"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Activity Countdown"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/border_green"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true"
                android:importantForAccessibility="yes" />

        </LinearLayout>

        <!-- SETUP LAYOUT -->
        <LinearLayout
            android:id="@+id/layoutSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Timer Duration"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Picker Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- Minutes Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="24dp">

                    <Button
                        android:id="@+id/btnDecMinutes"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:textColor="#000000"
                        android:backgroundTint="@color/lavender"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etMinutes"
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:text="0"
                        android:textColor="?android:attr/textColorPrimary"
                        android:backgroundTint="#FFFFFF"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:inputType="number"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="yes" />

                    <Button
                        android:id="@+id/btnIncMinutes"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textColor="#000000"
                        android:backgroundTint="@color/lavender" />

                </LinearLayout>

                <!-- Colon divider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:layout_marginBottom="24dp"
                    android:layout_marginEnd="24dp" />

                <!-- Seconds Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <Button
                        android:id="@+id/btnDecSeconds"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:textColor="#000000"
                        android:backgroundTint="@color/lavender"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etSeconds"
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:text="00"
                        android:textColor="?android:attr/textColorPrimary"
                        android:backgroundTint="#FFFFFF"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:inputType="number"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="yes" />

                    <Button
                        android:id="@+id/btnIncSeconds"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textColor="#000000"
                        android:backgroundTint="@color/lavender" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnStartTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Start Timer"
                android:textColor="#000000"
                android:backgroundTint="@color/lavender" />

        </LinearLayout>

        <!-- RUNNING LAYOUT -->
        <LinearLayout
            android:id="@+id/layoutRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <!-- Timer Display -->
            <TextView
                android:id="@+id/tvTimeDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="05:00"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="60sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="32dp"
                android:importantForAccessibility="yes" />

            <!-- Progress Indicator -->
            <ProgressBar
                android:id="@+id/pbActivity"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="48dp"
                android:importantForAccessibility="no" />

            <!-- Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnPauseResume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Pause"
                    android:textColor="#000000"
                    android:backgroundTint="@color/lavender"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnRestart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Restart"
                    android:textColor="#000000"
                    android:backgroundTint="@color/lavender"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnStop"
                    style="@style/Widget.VITeacherToolkit.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Stop" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
