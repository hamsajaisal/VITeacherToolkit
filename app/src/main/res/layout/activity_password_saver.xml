<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password Saver"
        android:textSize="26sp"
        android:layout_marginBottom="24dp"
        android:accessibilityHeading="true"/>

    <Button
        android:id="@+id/btnAddCredential"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Credential"
        android:contentDescription="Add a new saved credential"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCredentials"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Saved credentials list"/>

</LinearLayout>